# Robinhood Chain RPC (websocket endpoints also work with http polling)
RPC_URL=
CHAIN_ID=

# Deployed contract addresses (from contracts/deployments/robinhood.json)
LAUNCHPAD_ADDRESS=
FEE_DISTRIBUTOR_ADDRESS=
WETH_ADDRESS=

# First block to index (the launchpad deployment block)
START_BLOCK=0

# Server
PORT=8080
DB_PATH=./data/launchpad.db

# Indexer tuning
POLL_INTERVAL_MS=1500
MAX_BLOCK_RANGE=2000
REFRESH_INTERVAL_MS=30000
