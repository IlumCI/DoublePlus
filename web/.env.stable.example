# Steadypads on Stable Mainnet — LIVE values. Copy to .env.local (or pass as
# build env) and build:  VITE_BRAND=steadypads … npm run build

# Brand flavor + protocol
VITE_BRAND=steadypads
VITE_PROTOCOL=stable-v3
# Dollar rewards UI (no stock picker)
VITE_REWARD_MODE=dollar

# Chain — Stable mainnet
VITE_CHAIN_ID=988
VITE_CHAIN_NAME=Stable
VITE_RPC_URL=https://rpc.stable.xyz
VITE_EXPLORER_URL=https://stablescan.xyz
VITE_NATIVE_SYMBOL=USDT0

# StableLaunchpadFactory deployment (deployments/stable-launchpad.json)
VITE_FACTORY_ADDRESS=0x95472BE7fEE74fc819Ba762cd4F254301ba497D7
VITE_TOKEN_DEPLOYER_ADDRESS=0x79Fb68b0bFCd335f27E2dAF95716Fb49f38452C3

# Official Uniswap V3 on Stable + the ERC-20 USDT0 quote asset
VITE_SWAP_ROUTER=0x32eaf9B5d5F2CD7361c5012890C943D7de84C22a
VITE_QUOTE_ASSET=0x779Ded0c9e1022225f8E0630b35a9b54bE713736
VITE_WETH_ADDRESS=0x779Ded0c9e1022225f8E0630b35a9b54bE713736

# Backend-free mode: read straight from the chain
VITE_API_URL=
VITE_WS_URL=

# Optional: WalletConnect Cloud project id
VITE_WALLETCONNECT_PROJECT_ID=

# DexScreener chain slug (empty = chain not indexed; a Pool explorer link shows instead)
VITE_DEXSCREENER_CHAIN=stable
