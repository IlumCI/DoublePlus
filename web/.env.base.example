# stonkpad — Base stock launchpad. Copy to .env.base.local and fill in the
# WalletConnect project id, then build/run with `--mode base`
# (e.g. `npm run build -- --mode base`, `npm run dev -- --mode base`).
# Memecoins pair a tokenized stock; holders earn that stock via a per-coin vault.
VITE_BRAND=base
VITE_PROTOCOL=rh-v4
# Base-stock launch model: coins pair the creator-chosen stock (not WETH) and
# holders earn it. Flips the RhClient into base-stock mode.
VITE_LAUNCH_MODE=base-stock

VITE_CHAIN_ID=8453
VITE_CHAIN_NAME=Base
VITE_RPC_URL=https://mainnet.base.org
VITE_EXPLORER_URL=https://basescan.org
VITE_NATIVE_SYMBOL=ETH

# StockFlyFactoryV2 deployment (contracts/deployments/base-stockfly-v2.json)
VITE_RH_FACTORY=0xEA3dC62EbB16CAEB848c316a89D54a90Fc348301
VITE_RH_HOOK=0x5130c8Fb3B2F8fc1018F78fCC4223aFE8BAD6044
VITE_RH_ROUTER=0x9EfAd391f0b0759dF35d9f74FB444f778bF18759
VITE_RH_START_BLOCK=50169610

# Base Uniswap V4 infra
VITE_V4_POOL_MANAGER=0x498581fF718922c3f8e6A244956aF099B2652b2b
VITE_V4_WETH=0x4200000000000000000000000000000000000006
VITE_V4_STATE_VIEW=0xA3c0c9b65baD0b08107Aa264b0f3dB444b867A71

# env.ts required addresses (wallet metadata / helpers)
VITE_FACTORY_ADDRESS=0xEA3dC62EbB16CAEB848c316a89D54a90Fc348301
VITE_TOKEN_DEPLOYER_ADDRESS=0xEA3dC62EbB16CAEB848c316a89D54a90Fc348301
VITE_WETH_ADDRESS=0x4200000000000000000000000000000000000006

# Fill in from your WalletConnect Cloud project.
VITE_WALLETCONNECT_PROJECT_ID=
