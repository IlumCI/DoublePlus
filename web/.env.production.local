# copair on Robinhood Chain. Copy these into the deploy environment (or a
# build env) and build:  VITE_BRAND=copair … npm run build

VITE_BRAND=copair
# Pair=reward fork: a coin pairs against a chosen stock or meme, and holders
# earn that token (80% of fees). RhFactory/RhHook/RhRouter on chain 4663.
VITE_PROTOCOL=rh-v4

VITE_CHAIN_ID=4663
VITE_CHAIN_NAME="Robinhood Chain"
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
VITE_NATIVE_SYMBOL=ETH

# RhFinalFactory / RhFinalHook / RhRouter deployment (chain 4663)
# Model: pair against any token (stock/meme/ETH); reward = pair token.
# 80% holders / 20% creator. Ownership renounced; hardcoded admin retained.
VITE_RH_FACTORY=0x44F0fEF21366e9a8FA7e594FAc0166eA63efd62c
VITE_RH_HOOK=0xa775543d7CFd79de8Cf5305A60f11c990099C044
VITE_RH_ROUTER=0x7414F382cc855b318ad47B889c7eEEC1764d552F
VITE_RH_START_BLOCK=34558420

# V4 infra + quote assets on Robinhood Chain
VITE_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
VITE_V4_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
VITE_V4_USDG=0x5fc5360d0400a0fd4f2af552add042d716f1d168
VITE_V4_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b

# The SDK addresses block still needs these (unused by the rh client paths).
VITE_FACTORY_ADDRESS=0x6dE8C12324Cd13E40E813B390F8Eea38DBA299b0
VITE_TOKEN_DEPLOYER_ADDRESS=0x6dE8C12324Cd13E40E813B390F8Eea38DBA299b0
VITE_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Quote asset behavior: WETH is 18 decimals and IS the wrapped native, so
# buys pay plain ETH and sells unwrap back to ETH.
VITE_QUOTE_DECIMALS=18
VITE_QUOTE_IS_WNATIVE=true

# This RPC accepts multi-million block getLogs ranges; one request covers the
# whole recent window.
VITE_LOGS_WINDOW=5000000
VITE_SCAN_SPAN=5000000

VITE_API_URL=
VITE_WS_URL=

VITE_WALLETCONNECT_PROJECT_ID=e1bda672d5deb56579fe084dddfb9174

# DexScreener does not index Robinhood Chain; leave empty so the token page
# links the pool on Blockscout instead (address search would find same-address
# tokens from other chains).
VITE_DEXSCREENER_CHAIN=

# Platform-official tokens (comma-separated, gold OFFICIAL badge)
VITE_RH_OFFICIAL=0xbdd1b5639548b04fa95bb5f49b5a74a575be7fc3


# Hide every token from the public board (launch/token pages still work by address)
VITE_HIDE_TOKENS=false
