# doubleplus (flavor key: venture) — the startup-funding launchpad, on
# Robinhood Chain TESTNET (46630).
# Copy into the deploy environment (or web/.env.local) and build:
#   VITE_BRAND=venture … npm run build
#
# For mainnet (4663): swap chain id / RPC / explorer for the mainnet values,
# point the VITE_VENTURE_* addresses at deployments/venture-robinhood.json,
# set VITE_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73 and keep
# VITE_ETH_USD_8_FALLBACK near the live price (it is used only when live
# pricing fails, and keeps launches possible then).

VITE_BRAND=venture
VITE_PROTOCOL=venture-v4

VITE_CHAIN_ID=46630
VITE_CHAIN_NAME="Robinhood Chain Testnet"
VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com
VITE_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
VITE_NATIVE_SYMBOL=ETH

# VentureFactory stack — fill from contracts/deployments/venture-testnet.json
VITE_VENTURE_FACTORY=0x2044d0aBfa3B4CC6979cC35e9393001e8C35D073
VITE_VENTURE_TOKEN_DEPLOYER=0xD6Fb1Bf0D40521f815E8269eaee3D96Aae51e7ad
VITE_VENTURE_HOOK=0x6658Dc7f6bf82Ba88f0cAc1A412055CaF21E6044
VITE_VENTURE_ROUTER=0x6992aB52986bf7c68be0E9c2ae696A1bbF720584
VITE_VENTURE_START_BLOCK=139018407

# Protocol fee per trade in bps; mirrors the hook's immutable value.
VITE_PLATFORM_FEE_BPS=75
# Referrer's cut of the protocol fee in bps; mirrors the hook's immutable value.
VITE_REF_SHARE_BPS=2000
# VentureUpdates (on-chain founder IR feed); from the deployments file.
VITE_VENTURE_UPDATES=0x51FAadAff8e07fbCa28630AFfFac9f287d0ABeb0

# Canonical WETH9 on the testnet (verified, bridge-wrapped). Curve raises are
# in plain ETH; WETH is the pool quote + dividend currency.
VITE_WETH_ADDRESS=0x33e4191705c386532ba27cBF171Db86919200B94

# lib/env.ts requires these legacy slots; the venture app reads its own
# VITE_VENTURE_* addresses, so factory/deployer here just satisfy the check.
VITE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# Testnet Blockscout can't price ETH; the curve sizes its $3k starting FDV
# from this 8dp fallback instead. Scaled high so faucet-sized wallets can
# graduate a raise (~0.001 ETH minimum target). Clear on mainnet.
VITE_ETH_USD_8_FALLBACK=186500000000

VITE_API_URL=
VITE_WS_URL=

VITE_WALLETCONNECT_PROJECT_ID=e1bda672d5deb56579fe084dddfb9174

# DexScreener's chain slug. Verified against their live index: Robinhood Chain
# is `robinhood`. The venture app defaults to that when this is blank, so the
# DEX-paid profile badge works either way; setting it explicitly also turns on
# the DexScreener market link on the copair token page.
VITE_DEXSCREENER_CHAIN=robinhood

# Stock-paired ventures. OFF unless explicitly "true", and mainnet-only
# regardless: finalize() routes the raise through the V3 router to buy the pair
# asset, and testnet has no v3Router so that path cannot run there. Leave this
# off until the fork suite has exercised it against a real router.
VITE_VENTURE_STOCK_PAIRS=false

# Token chat API (api/ — Cloudflare Worker over Supabase). Unset hides the Chat tab.
VITE_VENTURE_API_URL=https://doubleplus-api.foxybro64.workers.dev
VITE_VENTURE_LIMIT_ORDERS=0x3AB83afFb008e67a773FFB5430303C59381c8F4d
VITE_VENTURE_PAYOUTS=0xa589969fedA792C718E8A60B329128F384DbA643
VITE_VENTURE_BOOSTS=0x63C3e083550A7E61bAd0122513E81f3b63B90862
