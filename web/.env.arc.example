# arcx.fun on Arc mainnet: V3 launchpad on the DyorSwap V3 factory (the pool
# source the chain's trading bots index). Native-USDC quote, 80/20 creator
# split on pool fees.
# Build:  set -a; source .env.production.local; set +a; npm run build

VITE_BRAND=arc
# V3 protocol path (StableV3Client), Arc flavor (ArcLaunchpadFactory ABI +
# ArcSwapRouter native buy/sell).
VITE_PROTOCOL=stable-v3
VITE_V3_FLAVOR=arc
VITE_FEE_MODE=creator
VITE_REWARD_MODE=dollar

VITE_CHAIN_ID=5042
VITE_CHAIN_NAME=Arc
# Keyed community proxy first (full service: calls, gas), then the site's own
# /api/rpc relay (same upstream, same-origin so nothing blocks it on mobile),
# then Blockscout reads. Swap for Circle's official RPC once published.
VITE_RPC_URL=https://arctorrpc-zwwbbvoo.b4a.run/?key=7629f78ccaf7e360ebefe49d6164ede3,https://arc-mainnet.cloud.blockscout.com/api/eth-rpc,https://real-pump-soon-trust-me-bro-again.poptyedev.com/b71fac7173778c3f6a9148c157b8b4f61d275b447b087327
VITE_EXPLORER_URL=https://arcexplorer-pz94fsom.b4a.run
VITE_MULTICALL3=0xC5B8D4975a7976F6DCe98B7Cb6Ec91b5D59E8C1e
VITE_NATIVE_SYMBOL=USDC

# Arc V3 launchpad deployment (deployments/arc-v3-launchpad.json)
VITE_FACTORY_ADDRESS=0xb6fEf7807587158B5d36EbE9a7c09F342C41929f
VITE_TOKEN_DEPLOYER_ADDRESS=0xd9fe5F1fade896B7ceC8002D05A4E03D4da0600b
VITE_SWAP_ROUTER=0x154B31f895DbBaDB47Cb2bc865Fa29f5109B7634
# Native USDC through its ERC-20 interface (6 decimals). Doubles as the
# legacy weth env slot, which env.ts requires.
VITE_QUOTE_ASSET=0x3600000000000000000000000000000000000000
VITE_WETH_ADDRESS=0x3600000000000000000000000000000000000000
VITE_QUOTE_DECIMALS=6
VITE_QUOTE_IS_WNATIVE=
VITE_START_BLOCK=13007764
# Swap-log scan shape; getLogs is currently disabled on the Arc RPC, so the
# client parks it and feeds trades from block receipts instead.
VITE_LOGS_WINDOW=500
VITE_SCAN_SPAN=5000

VITE_API_URL=
VITE_WS_URL=

VITE_WALLETCONNECT_PROJECT_ID=e1bda672d5deb56579fe084dddfb9174
